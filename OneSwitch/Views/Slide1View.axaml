<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OneSwitch.ViewModels"
             x:Class="OneSwitch.Views.Slide1View"
             x:DataType="vm:Slide1ViewModel">
    <StackPanel Spacing="4">
        <TextBlock Classes="title1" Text="{Binding Header.Title}" TextWrapping="Wrap"/>
        <TextBlock Classes="dim" Text="{Binding Header.Subtitle}" TextWrapping="Wrap"/>

        <UniformGrid Columns="2" ColumnSpacing="16" Margin="0,24,0,0">
            <!-- Taskbar layout -->
            <Button Classes="card" Classes.selected="{Binding WindowsOption.IsSelected}"
                    Command="{Binding WindowsOption.SelectCommand}">
                <Border Classes="card-body">
                    <StackPanel Spacing="12">
                        <Border Classes="preview">
                            <Grid RowDefinitions="*,Auto">
                                <Border Classes="preview-window" Margin="28,18,28,14"/>
                                <Border Grid.Row="1" Classes="preview-bar" Height="22">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0">
                                        <Border Classes="preview-dot accent" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                                    Margin="8,0" VerticalAlignment="Center">
                                            <Border Classes="preview-dot"/>
                                            <Border Classes="preview-dot"/>
                                            <Border Classes="preview-dot"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="preview-dot" Width="22" Height="6"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="heading card-title" Text="{Binding WindowsOption.Title}"/>
                                <TextBlock Classes="caption dim" Text="{Binding WindowsOption.Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="radio" Classes.on="{Binding WindowsOption.IsSelected}"
                                    VerticalAlignment="Top" Margin="12,0,0,0">
                                <Ellipse/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>

            <!-- Dock layout -->
            <Button Classes="card" Classes.selected="{Binding MacOsOption.IsSelected}"
                    Command="{Binding MacOsOption.SelectCommand}">
                <Border Classes="card-body">
                    <StackPanel Spacing="12">
                        <Border Classes="preview">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Border Classes="preview-bar" Height="10"/>
                                <Border Grid.Row="1" Classes="preview-window" Margin="28,12,28,8"/>
                                <Border Grid.Row="2" Classes="preview-bar" Height="22" CornerRadius="7"
                                        HorizontalAlignment="Center" Margin="0,0,0,8" Padding="6,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Border Classes="preview-dot accent"/>
                                        <Border Classes="preview-dot"/>
                                        <Border Classes="preview-dot"/>
                                        <Border Classes="preview-dot"/>
                                        <Border Classes="preview-dot"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="heading card-title" Text="{Binding MacOsOption.Title}"/>
                                <TextBlock Classes="caption dim" Text="{Binding MacOsOption.Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="radio" Classes.on="{Binding MacOsOption.IsSelected}"
                                    VerticalAlignment="Top" Margin="12,0,0,0">
                                <Ellipse/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>
        </UniformGrid>
    </StackPanel>
</UserControl>
