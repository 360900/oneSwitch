<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OneSwitch.ViewModels"
             xmlns:m="clr-namespace:OneSwitch.Models"
             xmlns:conv="clr-namespace:OneSwitch.Converters"
             x:Class="OneSwitch.Views.Slide3View"
             x:DataType="vm:Slide3ViewModel">
    <StackPanel Spacing="4">
        <TextBlock Classes="title1" Text="{Binding Header.Title}" TextWrapping="Wrap"/>
        <TextBlock Classes="dim" Text="{Binding Header.Subtitle}" TextWrapping="Wrap"/>

        <TextBlock Classes="group-title" Text="Your new system"/>
        <Border Classes="group">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,10" MinHeight="32">
                    <Border Classes="lead accent">
                        <PathIcon Data="{StaticResource Icon.Computer}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="strong" Text="{Binding SystemTitle}"/>
                        <TextBlock Classes="caption dim" Text="{Binding SystemSummary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Border Classes="separator"/>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="14,10" MinHeight="32">
                    <Border Classes="lead" Classes.success="{Binding IsGpuSupported}" Classes.warning="{Binding IsGpuWarning}">
                        <PathIcon Data="{Binding GpuIconKey, Converter={x:Static conv:IconConverter.Instance}}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="strong" Text="Graphics"/>
                        <TextBlock Classes="caption dim" Text="{Binding GpuStatusText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Border Classes="separator"/>
                <Button Classes="row" Command="{Binding OpenAppDictionaryCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="lead">
                            <PathIcon Data="{StaticResource Icon.AppGrid}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="strong" Text="Apps"/>
                            <TextBlock Classes="caption dim" Text="{Binding AppsSummaryText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <PathIcon Grid.Column="2" Data="{StaticResource Icon.PanEnd}" Foreground="{DynamicResource One.Text3}"/>
                    </Grid>
                </Button>

                <Border Classes="separator"/>
                <Button Classes="row" Command="{Binding OpenGameCompatCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="lead">
                            <PathIcon Data="{StaticResource Icon.Games}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="strong" Text="Games"/>
                            <TextBlock Classes="caption dim" Text="{Binding GameCompatSummaryText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <PathIcon Grid.Column="2" Data="{StaticResource Icon.PanEnd}" Foreground="{DynamicResource One.Text3}"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Classes="group-title" Text="Your files"/>
        <Border Classes="group">
            <ItemsControl ItemsSource="{Binding BackupOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:ISelectableOption">
                        <StackPanel>
                            <Border Classes="separator auto"/>
                            <Button Classes="row" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="lead" Classes.accent="{Binding IsSelected}">
                                        <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Classes="strong" Text="{Binding Title}"/>
                                        <TextBlock Classes="caption dim" Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="radio" Classes.on="{Binding IsSelected}">
                                        <Ellipse/>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
