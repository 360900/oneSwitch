<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OneSwitch.ViewModels"
             xmlns:views="clr-namespace:OneSwitch.Views"
             x:Class="OneSwitch.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:Slide1ViewModel">
            <views:Slide1View/>
        </DataTemplate>
        <DataTemplate DataType="vm:Slide2ViewModel">
            <views:Slide2View/>
        </DataTemplate>
        <DataTemplate DataType="vm:Slide3ViewModel">
            <views:Slide3View/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://OneSwitch/Theme/OneStyles.axaml"/>
    </Application.Styles>
</Application>
